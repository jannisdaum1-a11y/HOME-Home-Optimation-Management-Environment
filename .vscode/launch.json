{
    // Use IntelliSense to learn about possible attributes.
    // Hover to view descriptions of existing attributes.
    // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Python: pytest",
            "type": "debugpy",
            "request": "launch",
            "module": "pytest",
            "args": ["-q"],
            "justMyCode": false
        },
        {
            "name": "FastAPI",
            "type": "debugpy",
            "request": "launch",
            "module": "uvicorn",
            "args": ["api.main:app", "--host", "127.0.0.1", "--port", "8000"],
            "cwd": "${workspaceFolder}",
            "justMyCode": false
        },
        {
            "name": "Vite Frontend",
            "type": "node-terminal",
            "request": "launch",
            "command": "npm run dev",
            "cwd": "${workspaceFolder}/frontend/reactapp"
        }
    ],
    "compounds": [
        {
            "name": "HOME App (Frontend + API)",
            "configurations": ["FastAPI", "Vite Frontend"],
            "stopAll": true
        }
    ]
}